# متغیرهای لازم برای اجرای production (Coolify / Nixpacks)
# مقادیر واقعی را در پنل Coolify (Environment Variables) وارد کنید.

# --- دیتابیس PostgreSQL سلف‌هاست (Coolify) — الزامی ---
# سایت فقط با همین دیتابیس کار می‌کند. راهنمای کامل: docs/self-host-postgres.md
DATABASE_URL="postgresql://webyar:PASSWORD@webyar-db:5432/webyar"
# DATABASE_POOL_MAX=10
# برای سرور بیرونی با SSL:  ...?sslmode=require
# DATABASE_AUTO_MIGRATE=false   # غیرفعال کردن اجرای خودکار db/schema.sql هنگام بالا آمدن

# --- اختیاری ---
# رمز مسیرهای زمان‌بندی خارجی (/api/public/autoblog-cron و /api/public/seo-cron)؛
# درخواست باید هدر «Authorization: Bearer <CRON_SECRET>» داشته باشد.
# CRON_SECRET=""

# کلید API سرویس‌های هوش مصنوعی (OpenAI / Google Gemini) دیگر از متغیر محیطی خوانده نمی‌شود؛
# از پنل ادمین → تنظیمات عمومی → «کلیدهای API هوش مصنوعی» وارد و در دیتابیس ذخیره می‌شود.
